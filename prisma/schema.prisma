generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                           String                          @id @default(cuid())
  name                         String
  publicName                   String?
  type                         OrganizationType
  sport                        SportType                       @default(BOTH)
  slug                         String                          @unique
  description                  String?
  logoUrl                      String?
  coverUrl                     String?
  accentColor                  String?                         @default("#9DDB16")
  phone                        String?
  whatsapp                     String?
  email                        String?
  instagram                    String?
  address                      String?
  city                         String?
  state                        String?
  timezone                     String                          @default("America/Sao_Paulo")
  active                       Boolean                         @default(true)
  showAthletesPublicly         Boolean                         @default(true)
  showStaffPublicly            Boolean                         @default(true)
  showTrainingsPublicly        Boolean                         @default(true)
  showMatchesPublicly          Boolean                         @default(true)
  customDomain                 String?                         @unique
  domainVerified               Boolean                         @default(false)
  whatsappStatus               IntegrationStatus               @default(DISCONNECTED)
  whatsappPhone                String?
  paymentStatus                IntegrationStatus               @default(DISCONNECTED)
  paymentProvider              String?
  onboardingCompleted          Boolean                         @default(false)
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt
  panelTheme                   String                          @default("DARK")
  pixKey                       String?
  publicBackground             String?                         @default("#080B0C")
  publicTheme                  String                          @default("DARK")
  secondaryColor               String?                         @default("#FFFFFF")
  taxId                        String?
  coverOverlay                 Int                             @default(68)
  coverPosition                String                          @default("CENTER")
  accessStatus                 String                          @default("ACTIVE")
  complimentaryReason          String?
  complimentaryUntil           DateTime?
  documentStorageLimitBytes    BigInt                          @default(1073741824)
  documentStorageUsedBytes     BigInt                          @default(0)
  athletes                     Athlete[]
  athleteAuditLogs             AthleteDataAuditLog[]
  athleteDocuments             AthleteDocument[]
  athleteDocumentManualIssues  AthleteDocumentManualIssue[]
  categoryDocumentRequirements CategoryDocumentRequirement[]
  athleteRegistrationRequests  AthleteRegistrationRequest[]
  athletePreRegistrations      AthletePreRegistrationRequest[]
  athleteSportRegistrations    AthleteSportRegistration[]
  athleteMemberships           AthleteMembership[]
  athleteEvaluations           AthleteEvaluation[]
  athleteEvaluationProcesses   AthleteEvaluationProcess[]
  athleteExitRecords           AthleteExitRecord[]
  athleteEligibilityIssues     AthleteEligibilityIssue[]
  athletePerformanceGoals      AthletePerformanceGoal[]
  athleteBodyMeasurements      AthleteBodyMeasurement[]
  athleteWellbeingEntries      AthleteWellbeingEntry[]
  athleteExternalTrainings     AthleteExternalTraining[]
  athleteGpsRecords            AthleteGpsRecord[]
  performanceTemplates         PerformanceTemplate[]
  performanceReports           PerformanceReport[]
  monthlyAthleteReports        MonthlyAthleteReport[]
  callUps                      CallUp[]
  categories                   Category[]
  charges                      Charge[]
  coachAccesses                CoachOrganizationAccess[]
  matches                      Match[]
  matchAthleteStats            MatchAthleteStat[]
  matchEvents                  MatchEvent[]
  matchStaffAssignments        MatchStaffAssignment[]
  payments                     Payment[]
  qtrs                         Qtr[]
  qtrSettings                  QtrSettings?
  staffMembers                 StaffMember[]
  staffCategoryPermissions     StaffCategoryPermission[]
  subscription                 Subscription?
  trainingSchedules            TrainingSchedule[]
  trainingSessions             TrainingSession[]
  trainingAttendances          TrainingAttendance[]
  trainingAuditLogs            TrainingAuditLog[]
  athleteHistoryEntries        AthleteHistoryEntry[]
  userPermissionOverrides      ClubUserPermissionOverride[]
  users                        User[]
  competitions                 Competition[]
  linkedCompetitionTeams       CompetitionTeam[]               @relation("LinkedCompetitionOrganization")
  competitionCallUpRules       CompetitionCallUpRule[]
  formationTemplates           FormationTemplate[]
  AdminSupportSession          AdminSupportSession[]

  athleteGrowthProfiles     AthleteGrowthProfile[]
  athleteBoneAgeAssessments AthleteBoneAgeAssessment[]
}

model Competition {
  id                String            @id @default(cuid())
  organizationId    String
  name              String
  slug              String
  description       String?
  season            String?
  sport             SportType         @default(FOOTBALL)
  status            CompetitionStatus @default(DRAFT)
  format            CompetitionFormat @default(CUSTOM)
  startDate         DateTime?
  endDate           DateTime?
  registrationStart DateTime?
  registrationEnd   DateTime?
  maxTeams          Int?
  logoUrl           String?
  coverUrl          String?
  isPublic          Boolean           @default(false)
  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categories   CompetitionCategory[]
  teams        CompetitionTeam[]
  venues       CompetitionVenue[]
  callUpRules  CompetitionCallUpRule[]

  documentRequirements CompetitionDocumentRequirement[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([sport, status])
  @@index([startDate])
}

model CompetitionCategory {
  id                   String   @id @default(cuid())
  competitionId        String
  name                 String
  code                 String?
  birthYearFrom        Int?
  birthYearTo          Int?
  maxTeams             Int?
  rosterLimit          Int?
  matchDurationMinutes Int      @default(20)
  transitionMinutes    Int      @default(5)
  sortOrder            Int      @default(0)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  competition Competition             @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  teams       CompetitionTeam[]
  callUpRules CompetitionCallUpRule[]

  @@unique([competitionId, name])
  @@index([competitionId, active])
  @@index([competitionId, sortOrder])
}

model CompetitionTeam {
  id                   String                @id @default(cuid())
  competitionId        String
  categoryId           String
  linkedOrganizationId String?
  name                 String
  shortName            String?
  logoUrl              String?
  city                 String?
  state                String?
  responsibleName      String?
  responsibleEmail     String?
  responsiblePhone     String?
  status               CompetitionTeamStatus @default(PENDING)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  competition        Competition          @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  category           CompetitionCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  linkedOrganization Organization?        @relation("LinkedCompetitionOrganization", fields: [linkedOrganizationId], references: [id], onDelete: SetNull)
  athletes           CompetitionAthlete[]

  @@unique([competitionId, categoryId, name])
  @@index([competitionId, status])
  @@index([categoryId, status])
  @@index([linkedOrganizationId])
}

model CompetitionAthlete {
  id              String                   @id @default(cuid())
  teamId          String
  sourceAthleteId String?
  source          CompetitionAthleteSource @default(MANUAL)

  name         String
  birthDate    DateTime?
  photoUrl     String?
  jerseyNumber Int?
  position     String?

  sourceSnapshotAt DateTime?
  status           CompetitionAthleteStatus @default(APPROVED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team          CompetitionTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sourceAthlete Athlete?        @relation("CompetitionAthleteSource", fields: [sourceAthleteId], references: [id], onDelete: SetNull)

  documents  CompetitionAthleteDocument[]
  credential CompetitionAthleteCredential?

  @@index([teamId, status])
  @@index([teamId, name])
  @@index([birthDate])
  @@index([sourceAthleteId])
}

enum CompetitionAthleteSource {
  MANUAL
  CLUB_SHARED
}

enum CompetitionAthleteStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum CompetitionDocumentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum CompetitionDocumentSource {
  MANUAL_UPLOAD
  CLUB_SHARED
}

enum CompetitionCredentialStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
}

model CompetitionDocumentRequirement {
  id            String   @id @default(cuid())
  competitionId String
  name          String
  description   String?
  required      Boolean  @default(true)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition Competition                  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  documents   CompetitionAthleteDocument[]

  @@unique([competitionId, name])
  @@index([competitionId, active, sortOrder])
}

model CompetitionAthleteDocument {
  id            String                    @id @default(cuid())
  athleteId     String
  requirementId String
  source        CompetitionDocumentSource @default(MANUAL_UPLOAD)
  status        CompetitionDocumentStatus @default(PENDING)

  fileUrl           String?
  fileName          String?
  mimeType          String?
  sourceReferenceId String?

  reviewNotes      String?
  submittedAt      DateTime  @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athlete     CompetitionAthlete             @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  requirement CompetitionDocumentRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([athleteId, status])
  @@index([requirementId, status])
  @@index([athleteId, requirementId, createdAt])
}

model CompetitionAthleteCredential {
  id        String                      @id @default(cuid())
  athleteId String                      @unique
  code      String?                     @unique
  status    CompetitionCredentialStatus @default(DRAFT)

  issuedAt    DateTime?
  validUntil  DateTime?
  suspendedAt DateTime?
  revokedAt   DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athlete CompetitionAthlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([status, validUntil])
}

model CompetitionVenue {
  id            String   @id @default(cuid())
  competitionId String
  name          String
  address       String?
  city          String?
  state         String?
  fieldCount    Int      @default(1)
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@unique([competitionId, name])
  @@index([competitionId, active])
}

enum CompetitionStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  FINISHED
  ARCHIVED
}

enum CompetitionFormat {
  GROUP_STAGE_KNOCKOUT
  ROUND_ROBIN
  KNOCKOUT
  CUSTOM
}

enum CompetitionTeamStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

model User {
  id                                           String                       @id @default(cuid())
  name                                         String
  email                                        String                       @unique
  passwordHash                                 String
  role                                         UserRole                     @default(COORDINATOR)
  clubRole                                     ClubRole?
  active                                       Boolean                      @default(true)
  organizationId                               String?
  createdAt                                    DateTime                     @default(now())
  updatedAt                                    DateTime                     @updatedAt
  accountStatus                                String                       @default("ACTIVE")
  emailVerifiedAt                              DateTime?
  coachProfile                                 CoachProfile?
  clubInvites                                  ClubUserInvite[]
  emailVerificationTokens                      EmailVerificationToken[]
  athleteEvaluations                           AthleteEvaluation[]          @relation("AthleteEvaluationAuthor")
  evaluationProcessesCreated                   AthleteEvaluationProcess[]   @relation("AthleteEvaluationProcessCreator")
  evaluationProcessesDecided                   AthleteEvaluationProcess[]   @relation("AthleteEvaluationProcessDecider")
  athleteExitRecordsRecorded                   AthleteExitRecord[]          @relation("AthleteExitRecordRecorder")
  athleteEligibilityIssuesCreated              AthleteEligibilityIssue[]    @relation("AthleteEligibilityIssueCreator")
  athleteEligibilityIssuesResolved             AthleteEligibilityIssue[]    @relation("AthleteEligibilityIssueResolver")
  athleteEligibilityIssuesAuthorized           AthleteEligibilityIssue[]    @relation("AthleteEligibilityIssueAuthorizer")
  athleteEligibilityIssuesAuthorizationRevoked AthleteEligibilityIssue[]    @relation("AthleteEligibilityIssueAuthorizationRevoker")
  athletePerformanceGoals                      AthletePerformanceGoal[]     @relation("AthletePerformanceGoalAuthor")
  performanceReports                           PerformanceReport[]          @relation("PerformanceReportAuthor")
  monthlyReportsCreated                        MonthlyAthleteReport[]       @relation("MonthlyAthleteReportCreator")
  monthlyReportsReviewed                       MonthlyAthleteReport[]       @relation("MonthlyAthleteReportReviewer")
  monthlyReportsApproved                       MonthlyAthleteReport[]       @relation("MonthlyAthleteReportApprover")
  monthlyReportsSent                           MonthlyAthleteReport[]       @relation("MonthlyAthleteReportSender")
  permissionOverrides                          ClubUserPermissionOverride[]
  createdRegistrationRequests                  AthleteRegistrationRequest[] @relation("AthleteRegistrationRequestCreator")
  reviewedRegistrationRequests                 AthleteRegistrationRequest[] @relation("AthleteRegistrationRequestReviewer")
  uploadedAthleteDocuments                     AthleteDocument[]            @relation("AthleteDocumentUploader")
  documentManualIssuesCreated                  AthleteDocumentManualIssue[] @relation("AthleteDocumentManualIssueCreator")
  documentManualIssuesResolved                 AthleteDocumentManualIssue[] @relation("AthleteDocumentManualIssueResolver")
  reviewedAthleteDocuments                     AthleteDocument[]            @relation("AthleteDocumentReviewer")
  athleteDataAuditLogs                         AthleteDataAuditLog[]        @relation("AthleteDataAuditActor")
  recordedMatchAthleteStats                    MatchAthleteStat[]           @relation("MatchAthleteStatRecorder")
  recordedTrainingSessions                     TrainingSession[]            @relation("TrainingSessionRecorder")
  recordedTrainingAttendances                  TrainingAttendance[]         @relation("TrainingAttendanceRecorder")
  trainingAuditLogs                            TrainingAuditLog[]           @relation("TrainingAuditActor")
  athleteHistoryEntriesAuthored                AthleteHistoryEntry[]        @relation("AthleteHistoryEntryAuthor")
  athleteHistoryEntriesResolved                AthleteHistoryEntry[]        @relation("AthleteHistoryEntryResolver")
  staffMember                                  StaffMember?                 @relation("StaffMemberUser")
  recordedBodyMeasurements                     AthleteBodyMeasurement[]     @relation("AthleteBodyMeasurementRecorder")
  recordedWellbeingEntries                     AthleteWellbeingEntry[]      @relation("AthleteWellbeingEntryRecorder")
  recordedExternalTrainings                    AthleteExternalTraining[]    @relation("AthleteExternalTrainingRecorder")
  recordedGpsRecords                           AthleteGpsRecord[]           @relation("AthleteGpsRecordRecorder")
  guardianProfile                              GuardianProfile?
  payments                                     Payment[]
  sessions                                     Session[]
  organization                                 Organization?                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  AdminSupportSession                          AdminSupportSession[]

  createdGrowthProfiles      AthleteGrowthProfile[]     @relation("AthleteGrowthProfileCreator")
  recordedBoneAgeAssessments AthleteBoneAgeAssessment[] @relation("AthleteBoneAgeRecorder")

  @@index([organizationId])
}

model ClubUserInvite {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  userId    String
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id                             String                          @id @default(cuid())
  name                           String
  birthYear                      Int?
  description                    String?
  accentColor                    String                          @default("#9DDB16")
  type                           CategoryType                    @default(STANDARD)
  sport                          SportType                       @default(BOTH)
  active                         Boolean                         @default(true)
  requiresDocumentation          Boolean                         @default(true)
  requiresMedicalExam            Boolean                         @default(false)
  requiresFederationRegistration Boolean                         @default(false)
  organizationId                 String
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  athletes                       Athlete[]
  athletePreRegistrations        AthletePreRegistrationRequest[]
  athleteMemberships             AthleteMembership[]
  athleteEvaluations             AthleteEvaluation[]
  athletePerformanceGoals        AthletePerformanceGoal[]
  monthlyAthleteReports          MonthlyAthleteReport[]
  organization                   Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  coachAccesses                  CoachOrganizationAccess[]
  matches                        Match[]
  staffMembers                   StaffMember[]
  staffCategoryPermissions       StaffCategoryPermission[]
  trainingSchedules              TrainingSchedule[]
  trainingSessions               TrainingSession[]
  competitionCallUpRules         CompetitionCallUpRule[]
  documentRequirements           CategoryDocumentRequirement[]

  evaluationTargets           CategoryEvaluationTarget[] @relation("EvaluationCategoryTargets")
  targetedByEvaluations       CategoryEvaluationTarget[] @relation("EvaluationTargetCategories")
  evaluationTargetAthletes    Athlete[]                  @relation("AthleteEvaluationTargetCategory")
  evaluationProcessesAsSource AthleteEvaluationProcess[] @relation("AthleteEvaluationProcessEvaluationCategory")
  evaluationProcessesAsTarget AthleteEvaluationProcess[] @relation("AthleteEvaluationProcessTargetCategory")

  @@unique([organizationId, name, sport, type])
  @@index([organizationId])
  @@index([organizationId, sport, type, active])
}

model CategoryEvaluationTarget {
  id                   String   @id @default(cuid())
  evaluationCategoryId String
  targetCategoryId     String
  createdAt            DateTime @default(now())

  evaluationCategory Category @relation("EvaluationCategoryTargets", fields: [evaluationCategoryId], references: [id], onDelete: Cascade)
  targetCategory     Category @relation("EvaluationTargetCategories", fields: [targetCategoryId], references: [id], onDelete: Cascade)

  @@unique([evaluationCategoryId, targetCategoryId])
  @@index([evaluationCategoryId])
  @@index([targetCategoryId])
}

model StaffMember {
  id                           String                    @id @default(cuid())
  name                         String
  roleTitle                    String
  photoUrl                     String?
  bio                          String?
  phone                        String?
  professionalRegistration     String?
  education                    String?
  specialties                  String?
  joinedAt                     DateTime?
  active                       Boolean                   @default(true)
  organizationId               String
  categoryId                   String?
  userId                       String?                   @unique
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  canManageCallUps             Boolean                   @default(false)
  coachEmail                   String?
  sport                        SportType                 @default(BOTH)
  category                     Category?                 @relation(fields: [categoryId], references: [id])
  organization                 Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                         User?                     @relation("StaffMemberUser", fields: [userId], references: [id], onDelete: SetNull)
  matchAssignments             MatchStaffAssignment[]
  categoryPermissions          StaffCategoryPermission[]
  responsibleTrainingSchedules TrainingSchedule[]        @relation("TrainingScheduleResponsible")
  responsibleTrainingSessions  TrainingSession[]         @relation("TrainingSessionResponsible")

  @@index([organizationId])
  @@index([categoryId])
}

model Athlete {
  id                         String                       @id @default(cuid())
  name                       String
  nickname                   String?
  jerseyNumber               Int?
  position                   String?
  dominantFoot               String?
  birthYear                  Int?
  photoUrl                   String?
  active                     Boolean                      @default(true)
  currentStatus              AthleteCurrentStatus         @default(ACTIVE)
  guardianName               String?
  guardianPhone              String?
  guardianEmail              String?
  organizationId             String
  categoryId                 String?
  evaluationTargetCategoryId String?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  documentationConfirmedAt   DateTime?
  guardianRelation           String?
  category                   Category?                    @relation(fields: [categoryId], references: [id])
  evaluationTargetCategory   Category?                    @relation("AthleteEvaluationTargetCategory", fields: [evaluationTargetCategoryId], references: [id], onDelete: SetNull)
  organization               Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships                AthleteMembership[]
  callUps                    CallUp[]
  charges                    Charge[]
  playerLinks                PlayerAthleteLink[]
  evaluations                AthleteEvaluation[]
  evaluationProcesses        AthleteEvaluationProcess[]
  exitRecords                AthleteExitRecord[]
  eligibilityIssues          AthleteEligibilityIssue[]
  performanceGoals           AthletePerformanceGoal[]
  performanceReports         PerformanceReport[]
  monthlyReports             MonthlyAthleteReport[]
  matchStats                 MatchAthleteStat[]
  matchEvents                MatchEvent[]
  trainingAttendances        TrainingAttendance[]
  bodyMeasurements           AthleteBodyMeasurement[]
  wellbeingEntries           AthleteWellbeingEntry[]
  externalTrainings          AthleteExternalTraining[]
  gpsRecords                 AthleteGpsRecord[]
  privateData                AthletePrivateData?
  guardians                  AthleteGuardian[]
  documents                  AthleteDocument[]
  documentManualIssues       AthleteDocumentManualIssue[]
  registrationRequests       AthleteRegistrationRequest[]
  sportRegistrations         AthleteSportRegistration[]
  dataAuditLogs              AthleteDataAuditLog[]
  historyEntries             AthleteHistoryEntry[]
  competitionEntries         CompetitionAthlete[]         @relation("CompetitionAthleteSource")

  growthProfile      AthleteGrowthProfile?
  boneAgeAssessments AthleteBoneAgeAssessment[]

  @@index([organizationId])
  @@index([organizationId, currentStatus])
  @@index([categoryId])
  @@index([evaluationTargetCategoryId])
  @@index([name])
}

model AthleteSportRegistration {
  id                 String                       @id @default(cuid())
  organizationId     String
  athleteId          String
  sport              SportType
  authorityType      AthleteRegistrationAuthority
  authorityName      String?
  registrationNumber String
  status             AthleteRegistrationStatus    @default(ACTIVE)
  issuedAt           DateTime?
  expiresAt          DateTime?
  notes              String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athlete      Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, sport, authorityType])
  @@index([organizationId, sport, authorityType])
  @@index([registrationNumber])
}

model ClubUserPermissionOverride {
  id             String             @id @default(cuid())
  organizationId String
  userId         String
  permission     ClubPermissionCode
  enabled        Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([organizationId, permission])
}

model StaffCategoryPermission {
  id             String             @id @default(cuid())
  organizationId String
  staffMemberId  String
  categoryId     String
  sport          SportType          @default(BOTH)
  permission     ClubPermissionCode
  enabled        Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffMember  StaffMember  @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([staffMemberId, categoryId, sport, permission])
  @@index([organizationId, categoryId, permission])
  @@index([staffMemberId, enabled])
}

model AthletePrivateData {
  id                                String    @id @default(cuid())
  athleteId                         String    @unique
  birthDate                         DateTime?
  rgEncrypted                       String?
  rgIssuerEncrypted                 String?
  cpfEncrypted                      String?
  nationality                       String?
  naturality                        String?
  email                             String?
  instagram                         String?
  bloodTypeEncrypted                String?
  allergiesEncrypted                String?
  medicationsEncrypted              String?
  healthConditionsEncrypted         String?
  medicalRestrictionsEncrypted      String?
  healthPlanEncrypted               String?
  healthPlanNumberEncrypted         String?
  emergencyContactNameEncrypted     String?
  emergencyContactPhoneEncrypted    String?
  emergencyContactRelationEncrypted String?
  medicalNotesEncrypted             String?
  createdAt                         DateTime  @default(now())
  updatedAt                         DateTime  @updatedAt
  athlete                           Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

model AthleteGuardian {
  id                  String              @id @default(cuid())
  athleteId           String
  relation            AthleteGuardianType
  name                String
  rgEncrypted         String?
  rgIssuerEncrypted   String?
  cpfEncrypted        String?
  nationality         String?
  naturality          String?
  maritalStatus       String?
  profession          String?
  email               String?
  phone               String?
  address             String?
  city                String?
  neighborhood        String?
  postalCode          String?
  instagram           String?
  isPrimary           Boolean             @default(false)
  authorizedForPickup Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  athlete             Athlete             @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  documents           AthleteDocument[]

  @@index([athleteId, relation])
  @@index([athleteId, isPrimary])
}

model AthleteRegistrationRequest {
  id               String                           @id @default(cuid())
  organizationId   String
  athleteId        String
  createdByUserId  String?
  reviewedByUserId String?
  tokenHash        String                           @unique
  status           AthleteRegistrationRequestStatus @default(PENDING)
  recipientName    String?
  recipientEmail   String?
  recipientPhone   String?
  payloadEncrypted String?
  expiresAt        DateTime
  submittedAt      DateTime?
  reviewedAt       DateTime?
  rejectionReason  String?
  revokedAt        DateTime?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt
  organization     Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athlete          Athlete                          @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdBy        User?                            @relation("AthleteRegistrationRequestCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedBy       User?                            @relation("AthleteRegistrationRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  documents        AthleteDocument[]

  @@index([organizationId, status, createdAt])
  @@index([athleteId, status])
  @@index([expiresAt])
}

model AthleteDocument {
  id                       String                       @id @default(cuid())
  organizationId           String
  athleteId                String
  guardianId               String?
  registrationRequestId    String?
  uploadedByUserId         String?
