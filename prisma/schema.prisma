generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                          String                       @id @default(cuid())
  name                        String
  publicName                  String?
  type                        OrganizationType
  sport                       SportType                    @default(BOTH)
  slug                        String                       @unique
  description                 String?
  logoUrl                     String?
  coverUrl                    String?
  accentColor                 String?                      @default("#9DDB16")
  phone                       String?
  whatsapp                    String?
  email                       String?
  instagram                   String?
  address                     String?
  city                        String?
  state                       String?
  timezone                    String                       @default("America/Sao_Paulo")
  active                      Boolean                      @default(true)
  showAthletesPublicly        Boolean                      @default(true)
  showStaffPublicly           Boolean                      @default(true)
  showTrainingsPublicly       Boolean                      @default(true)
  showMatchesPublicly         Boolean                      @default(true)
  customDomain                String?                      @unique
  domainVerified              Boolean                      @default(false)
  whatsappStatus              IntegrationStatus            @default(DISCONNECTED)
  whatsappPhone               String?
  paymentStatus               IntegrationStatus            @default(DISCONNECTED)
  paymentProvider             String?
  onboardingCompleted         Boolean                      @default(false)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  panelTheme                  String                       @default("DARK")
  pixKey                      String?
  publicBackground            String?                      @default("#080B0C")
  publicTheme                 String                       @default("DARK")
  secondaryColor              String?                      @default("#FFFFFF")
  taxId                       String?
  coverOverlay                Int                          @default(68)
  coverPosition               String                       @default("CENTER")
  accessStatus                String                       @default("ACTIVE")
  complimentaryReason         String?
  complimentaryUntil          DateTime?
  documentStorageLimitBytes   BigInt                       @default(1073741824)
  documentStorageUsedBytes    BigInt                       @default(0)
  athletes                    Athlete[]
  athleteAuditLogs            AthleteDataAuditLog[]
  athleteDocuments            AthleteDocument[]
  athleteRegistrationRequests AthleteRegistrationRequest[]
  athleteMemberships          AthleteMembership[]
  athleteEvaluations          AthleteEvaluation[]
  athletePerformanceGoals     AthletePerformanceGoal[]
  athleteBodyMeasurements     AthleteBodyMeasurement[]
  athleteWellbeingEntries     AthleteWellbeingEntry[]
  athleteExternalTrainings    AthleteExternalTraining[]
  performanceTemplates        PerformanceTemplate[]
  performanceReports          PerformanceReport[]
  callUps                     CallUp[]
  categories                  Category[]
  charges                     Charge[]
  coachAccesses               CoachOrganizationAccess[]
  matches                     Match[]
  matchAthleteStats           MatchAthleteStat[]
  payments                    Payment[]
  qtrs                        Qtr[]
  staffMembers                StaffMember[]
  subscription                Subscription?
  trainingSchedules           TrainingSchedule[]
  trainingSessions            TrainingSession[]
  trainingAttendances         TrainingAttendance[]
  userPermissionOverrides     ClubUserPermissionOverride[]
  users                       User[]
}

model User {
  id                           String                       @id @default(cuid())
  name                         String
  email                        String                       @unique
  passwordHash                 String
  role                         UserRole                     @default(COORDINATOR)
  clubRole                     ClubRole?
  active                       Boolean                      @default(true)
  organizationId               String?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  accountStatus                String                       @default("ACTIVE")
  emailVerifiedAt              DateTime?
  coachProfile                 CoachProfile?
  clubInvites                  ClubUserInvite[]
  emailVerificationTokens      EmailVerificationToken[]
  athleteEvaluations           AthleteEvaluation[]          @relation("AthleteEvaluationAuthor")
  athletePerformanceGoals      AthletePerformanceGoal[]     @relation("AthletePerformanceGoalAuthor")
  performanceReports           PerformanceReport[]          @relation("PerformanceReportAuthor")
  permissionOverrides          ClubUserPermissionOverride[]
  createdRegistrationRequests  AthleteRegistrationRequest[] @relation("AthleteRegistrationRequestCreator")
  reviewedRegistrationRequests AthleteRegistrationRequest[] @relation("AthleteRegistrationRequestReviewer")
  uploadedAthleteDocuments     AthleteDocument[]            @relation("AthleteDocumentUploader")
  reviewedAthleteDocuments     AthleteDocument[]            @relation("AthleteDocumentReviewer")
  athleteDataAuditLogs         AthleteDataAuditLog[]        @relation("AthleteDataAuditActor")
  recordedMatchAthleteStats    MatchAthleteStat[]           @relation("MatchAthleteStatRecorder")
  recordedTrainingSessions     TrainingSession[]            @relation("TrainingSessionRecorder")
  recordedTrainingAttendances  TrainingAttendance[]         @relation("TrainingAttendanceRecorder")
  recordedBodyMeasurements     AthleteBodyMeasurement[]     @relation("AthleteBodyMeasurementRecorder")
  recordedWellbeingEntries     AthleteWellbeingEntry[]      @relation("AthleteWellbeingEntryRecorder")
  recordedExternalTrainings    AthleteExternalTraining[]    @relation("AthleteExternalTrainingRecorder")
  guardianProfile              GuardianProfile?
  payments                     Payment[]
  sessions                     Session[]
  organization                 Organization?                @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model ClubUserInvite {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  userId    String
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id                      String                    @id @default(cuid())
  name                    String
  birthYear               Int?
  organizationId          String
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  athletes                Athlete[]
  athleteMemberships      AthleteMembership[]
  athleteEvaluations      AthleteEvaluation[]
  athletePerformanceGoals AthletePerformanceGoal[]
  organization            Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  coachAccesses           CoachOrganizationAccess[]
  matches                 Match[]
  staffMembers            StaffMember[]
  trainingSchedules       TrainingSchedule[]
  trainingSessions        TrainingSession[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model StaffMember {
  id               String       @id @default(cuid())
  name             String
  roleTitle        String
  photoUrl         String?
  bio              String?
  organizationId   String
  categoryId       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  canManageCallUps Boolean      @default(false)
  coachEmail       String?
  sport            SportType    @default(BOTH)
  category         Category?    @relation(fields: [categoryId], references: [id])
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([categoryId])
}

model Athlete {
  id                   String                       @id @default(cuid())
  name                 String
  nickname             String?
  jerseyNumber         Int?
  position             String?
  dominantFoot         String?
  birthYear            Int?
  photoUrl             String?
  active               Boolean                      @default(true)
  guardianName         String?
  guardianPhone        String?
  guardianEmail        String?
  organizationId       String
  categoryId           String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  guardianRelation     String?
  category             Category?                    @relation(fields: [categoryId], references: [id])
  organization         Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships          AthleteMembership[]
  callUps              CallUp[]
  charges              Charge[]
  playerLinks          PlayerAthleteLink[]
  evaluations          AthleteEvaluation[]
  performanceGoals     AthletePerformanceGoal[]
  performanceReports   PerformanceReport[]
  matchStats           MatchAthleteStat[]
  trainingAttendances  TrainingAttendance[]
  bodyMeasurements     AthleteBodyMeasurement[]
  wellbeingEntries     AthleteWellbeingEntry[]
  externalTrainings    AthleteExternalTraining[]
  privateData          AthletePrivateData?
  guardians            AthleteGuardian[]
  documents            AthleteDocument[]
  registrationRequests AthleteRegistrationRequest[]
  dataAuditLogs        AthleteDataAuditLog[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([name])
}

model ClubUserPermissionOverride {
  id             String             @id @default(cuid())
  organizationId String
  userId         String
  permission     ClubPermissionCode
  enabled        Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([organizationId, permission])
}

model AthletePrivateData {
  id                    String    @id @default(cuid())
  athleteId             String    @unique
  birthDate             DateTime?
  rgEncrypted           String?
  rgIssuerEncrypted     String?
  cpfEncrypted          String?
  nationality           String?
  naturality            String?
  email                 String?
  instagram             String?
  medicalNotesEncrypted String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  athlete               Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

model AthleteGuardian {
  id                  String              @id @default(cuid())
  athleteId           String
  relation            AthleteGuardianType
  name                String
  rgEncrypted         String?
  rgIssuerEncrypted   String?
  cpfEncrypted        String?
  nationality         String?
  naturality          String?
  maritalStatus       String?
  profession          String?
  email               String?
  phone               String?
  address             String?
  city                String?
  neighborhood        String?
  postalCode          String?
  instagram           String?
  isPrimary           Boolean             @default(false)
  authorizedForPickup Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  athlete             Athlete             @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, relation])
  @@index([athleteId, isPrimary])
}

model AthleteRegistrationRequest {
  id               String                           @id @default(cuid())
  organizationId   String
  athleteId        String
  createdByUserId  String?
  reviewedByUserId String?
  tokenHash        String                           @unique
  status           AthleteRegistrationRequestStatus @default(PENDING)
  recipientName    String?
  recipientEmail   String?
  recipientPhone   String?
  payloadEncrypted String?
  expiresAt        DateTime
  submittedAt      DateTime?
  reviewedAt       DateTime?
  rejectionReason  String?
  revokedAt        DateTime?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt
  organization     Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athlete          Athlete                          @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdBy        User?                            @relation("AthleteRegistrationRequestCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedBy       User?                            @relation("AthleteRegistrationRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  documents        AthleteDocument[]

  @@index([organizationId, status, createdAt])
  @@index([athleteId, status])
  @@index([expiresAt])
}

model AthleteDocument {
  id                    String                      @id @default(cuid())
  organizationId        String
  athleteId             String
  registrationRequestId String?
  uploadedByUserId      String?
  reviewedByUserId      String?
  category              AthleteDocumentCategory
  status                AthleteDocumentStatus       @default(PENDING)
  title                 String
  storageProvider       String                      @default("CLOUDFLARE_R2")
  storageKey            String                      @unique
  originalFileName      String
  mimeType              String
  sizeBytes             Int
  checksumSha256        String?
  issuedAt              DateTime?
  expiresAt             DateTime?
  reviewedAt            DateTime?
  rejectionReason       String?
  deletedAt             DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  organization          Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athlete               Athlete                     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  registrationRequest   AthleteRegistrationRequest? @relation(fields: [registrationRequestId], references: [id], onDelete: SetNull)
  uploadedBy            User?                       @relation("AthleteDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  reviewedBy            User?                       @relation("AthleteDocumentReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, athleteId, category])
  @@index([athleteId, status])
  @@index([expiresAt])
  @@index([registrationRequestId])
}

model AthleteDataAuditLog {
  id             String                 @id @default(cuid())
  organizationId String
  athleteId      String
  actorUserId    String?
  action         AthleteDataAuditAction
  entityType     String
  entityId       String?
  metadataJson   String?
  ipHash         String?
  createdAt      DateTime               @default(now())
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athlete        Athlete                @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  actor          User?                  @relation("AthleteDataAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([athleteId, createdAt])
  @@index([actorUserId, createdAt])
}

model TrainingSchedule {
  id             String            @id @default(cuid())
  date           DateTime?
  weekday        Int
  startTime      String
  endTime        String
  location       String?
  notes          String?
  organizationId String
  categoryId     String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  category       Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions       TrainingSession[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([organizationId, date])
}

model TrainingSession {
  id               String                @id @default(cuid())
  organizationId   String
  categoryId       String
  scheduleId       String?
  recordedByUserId String?
  startsAt         DateTime
  endsAt           DateTime?
  location         String?
  notes            String?
  status           TrainingSessionStatus @default(SCHEDULED)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category         Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  schedule         TrainingSchedule?     @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  recordedBy       User?                 @relation("TrainingSessionRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  attendances      TrainingAttendance[]

  @@index([organizationId, startsAt])
  @@index([categoryId, startsAt])
  @@index([scheduleId])
  @@index([recordedByUserId])
}

model TrainingAttendance {
  id               String                   @id @default(cuid())
  organizationId   String
  sessionId        String
  athleteId        String
  recordedByUserId String?
  status           TrainingAttendanceStatus @default(PENDING)
  arrivedAt        DateTime?
  leftAt           DateTime?
  minutesPresent   Int?
  notes            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session          TrainingSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete          Athlete                  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  recordedBy       User?                    @relation("TrainingAttendanceRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@unique([sessionId, athleteId])
  @@index([organizationId, athleteId])
  @@index([athleteId, status])
  @@index([recordedByUserId])
}

model AthleteEvaluation {
  id                String                   @id @default(cuid())
  organizationId    String
  athleteId         String
  categoryId        String?
  evaluatorUserId   String?
  templateId        String?
  title             String?
  periodStart       DateTime
  periodEnd         DateTime
  evaluatedAt       DateTime                 @default(now())
  season            String?
  sport             SportType                @default(BOTH)
  athleteRole       PerformanceAthleteRole   @default(LINE_PLAYER)
  positionSnapshot  String?
  status            AthleteEvaluationStatus  @default(DRAFT)
  strengths         String?
  developmentPoints String?
  nextGoals         String?
  internalNotes     String?
  summary           String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athlete           Athlete                  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  category          Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  evaluator         User?                    @relation("AthleteEvaluationAuthor", fields: [evaluatorUserId], references: [id], onDelete: SetNull)
  template          PerformanceTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  scores            AthleteEvaluationScore[]
  reports           PerformanceReport[]

  @@index([organizationId, athleteId, evaluatedAt])
  @@index([categoryId, evaluatedAt])
  @@index([evaluatorUserId])
  @@index([templateId])
  @@index([status])
}

model AthleteEvaluationScore {
  id                String                @id @default(cuid())
  evaluationId      String
  criterionId       String?
  area              PerformanceArea
  metricCode        String
  metricLabel       String
  score             Int
  ratingLabel       String?
  ratingDescription String?
  notes             String?
  sortOrder         Int                   @default(0)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  evaluation        AthleteEvaluation     @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion         PerformanceCriterion? @relation(fields: [criterionId], references: [id], onDelete: SetNull)

  @@unique([evaluationId, metricCode])
  @@index([evaluationId, area])
  @@index([criterionId])
}

model PerformanceTemplate {
  id             String                 @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  athleteRole    PerformanceAthleteRole
  sport          SportType              @default(BOTH)
  active         Boolean                @default(true)
  systemDefault  Boolean                @default(false)
  version        Int                    @default(1)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  criteria       PerformanceCriterion[]
  evaluations    AthleteEvaluation[]

  @@index([organizationId, active])
  @@index([athleteRole, sport, active])
}

model PerformanceCriterion {
  id          String                      @id @default(cuid())
  templateId  String
  area        PerformanceArea
  code        String
  label       String
  description String?
  sortOrder   Int                         @default(0)
  active      Boolean                     @default(true)
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  template    PerformanceTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  levels      PerformanceCriterionLevel[]
  scores      AthleteEvaluationScore[]

  @@unique([templateId, code])
  @@index([templateId, area, sortOrder])
}

model PerformanceCriterionLevel {
  id          String               @id @default(cuid())
  criterionId String
  score       Int
  label       String
  description String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  criterion   PerformanceCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([criterionId, score])
  @@index([criterionId])
}

model AthletePerformanceGoal {
  id              String                @id @default(cuid())
  organizationId  String
  athleteId       String
  categoryId      String?
  createdByUserId String?
  area            PerformanceArea
  title           String
  description     String?
  status          PerformanceGoalStatus @default(NOT_STARTED)
  targetDate      DateTime?
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athlete         Athlete               @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  category        Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy       User?                 @relation("AthletePerformanceGoalAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, athleteId, status])
  @@index([categoryId])
  @@index([createdByUserId])
}

model AthleteBodyMeasurement {
  id               String       @id @default(cuid())
  organizationId   String
  athleteId        String
  recordedByUserId String?
  measuredAt       DateTime     @default(now())
  heightCm         Decimal?     @db.Decimal(6, 2)
  weightKg         Decimal?     @db.Decimal(6, 2)
  bmi              Decimal?     @db.Decimal(5, 2)
  wingspanCm       Decimal?     @db.Decimal(6, 2)
  bodyFatPercent   Decimal?     @db.Decimal(5, 2)
  muscleMassKg     Decimal?     @db.Decimal(6, 2)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athlete          Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  recordedBy       User?        @relation("AthleteBodyMeasurementRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, athleteId, measuredAt])
  @@index([athleteId, measuredAt])
  @@index([recordedByUserId])
}

model AthleteWellbeingEntry {
  id               String               @id @default(cuid())
  organizationId   String
  athleteId        String
  recordedByUserId String?
  recordedAt       DateTime             @default(now())
  sleepHours       Decimal?             @db.Decimal(4, 2)
  sleepQuality     Int?
  fatigueLevel     Int?
  energyLevel      Int?
  hasPain          Boolean              @default(false)
  painLevel        Int?
  painLocation     String?
  notes            String?
  source           WellbeingEntrySource @default(CLUB)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athlete          Athlete              @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  recordedBy       User?                @relation("AthleteWellbeingEntryRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, athleteId, recordedAt])
  @@index([athleteId, recordedAt])
  @@index([recordedByUserId])
}

model AthleteExternalTraining {
  id               String                 @id @default(cuid())
  organizationId   String
  athleteId        String
  recordedByUserId String?
  activity         String
  modality         String?
  providerName     String?
  weekdays         String?
  startTime        String?
  endTime          String?
  durationMinutes  Int?
  intensity        TrainingIntensity?
  objective        String?
  startsAt         DateTime?
  endsAt           DateTime?
  status           ExternalTrainingStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athlete          Athlete                @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  recordedBy       User?                  @relation("AthleteExternalTrainingRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, athleteId, status])
  @@index([athleteId, startsAt])
  @@index([recordedByUserId])
}

model PerformanceReport {
  id                   String             @id @default(cuid())
  organizationId       String
  athleteId            String
  evaluationId         String?
  generatedByUserId    String?
  title                String
  includeScores        Boolean            @default(true)
  includeInternalNotes Boolean            @default(false)
  tokenHash            String             @unique
  expiresAt            DateTime?
  revokedAt            DateTime?
  createdAt            DateTime           @default(now())
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athlete              Athlete            @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  evaluation           AthleteEvaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
  generatedBy          User?              @relation("PerformanceReportAuthor", fields: [generatedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, athleteId, createdAt])
  @@index([evaluationId])
  @@index([generatedByUserId])
  @@index([expiresAt])
}

model Match {
  id               String             @id @default(cuid())
  competition      String?
  round            String?
  opponent         String
  startsAt         DateTime
  location         String?
  homeAway         String?
  status           MatchStatus        @default(SCHEDULED)
  goalsFor         Int?
  goalsAgainst     Int?
  notes            String?
  formation        String?
  matchSheetStatus MatchSheetStatus   @default(DRAFT)
  finalizedAt      DateTime?
  organizationId   String
  categoryId       String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  callUps          CallUp[]
  charges          Charge[]
  athleteStats     MatchAthleteStat[]
  category         Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startsAt])
  @@index([categoryId, startsAt])
}

model MatchAthleteStat {
  id               String                   @id @default(cuid())
  organizationId   String
  matchId          String
  athleteId        String
  recordedByUserId String?
  participation    MatchParticipationStatus @default(RELATED)
  lineupRole       MatchLineupRole?
  enteredAtMinute  Int?
  leftAtMinute     Int?
  minutesPlayed    Int?
  positionPlayed   String?
  jerseyNumber     Int?
  goals            Int                      @default(0)
  assists          Int                      @default(0)
  yellowCards      Int                      @default(0)
  redCards         Int                      @default(0)
  notes            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  match            Match                    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  athlete          Athlete                  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  recordedBy       User?                    @relation("MatchAthleteStatRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@unique([matchId, athleteId])
  @@index([organizationId, athleteId])
  @@index([athleteId, participation])
  @@index([recordedByUserId])
}

model CallUp {
  id             String       @id @default(cuid())
  status         CallUpStatus @default(PENDING)
  sentAt         DateTime?
  respondedAt    DateTime?
  notes          String?
  organizationId String
  matchId        String
  athleteId      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  athlete        Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  match          Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([matchId, athleteId])
  @@index([organizationId])
  @@index([matchId])
  @@index([athleteId])
}

model Charge {
  id             String       @id @default(cuid())
  type           ChargeType
  title          String
  description    String?
  amountCents    Int
  dueDate        DateTime
  status         ChargeStatus @default(PENDING)
  paidAt         DateTime?
  paymentMethod  String?
  externalId     String?
  organizationId String
  athleteId      String
  matchId        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  athlete        Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  match          Match?       @relation(fields: [matchId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([athleteId])
  @@index([matchId])
  @@index([status])
  @@index([dueDate])
}

model Subscription {
  id                     String             @id @default(cuid())
  plan                   PlanCode           @default(STARTER)
  status                 SubscriptionStatus @default(TRIAL)
  trialEnds              DateTime?
  organizationId         String             @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  billingCycle           String?
  currentPeriodEnd       DateTime?
  provider               String?
  providerSubscriptionId String?
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model GuardianProfile {
  id                String          @id @default(cuid())
  userId            String          @unique
  phone             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  referredByCoachId String?
  referredByCoach   CoachProfile?   @relation("CoachReferrals", fields: [referredByCoachId], references: [id])
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  players           PlayerProfile[]
}

model PlayerProfile {
  id                  String              @id @default(cuid())
  slug                String              @unique
  name                String
  nickname            String?
  birthYear           Int?
  position            String?
  dominantFoot        String?
  height              String?
  currentClub         String?
  photoUrl            String?
  bio                 String?
  instagram           String?
  videos              String?
  gallery             String?
  isPublic            Boolean             @default(false)
  guardianId          String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  achievements        String?
  assists             Int?
  careerHistory       String?
  coverUrl            String?
  goals               Int?
  matches             Int?
  nationality         String?
  secondaryPosition   String?
  template            String              @default("FREE_CLEAN")
  titles              Int?
  weight              String?
  categoryLabel       String?
  complimentaryReason String?
  complimentaryUntil  DateTime?
  directoryVisible    Boolean             @default(false)
  isComplimentary     Boolean             @default(false)
  jerseyNumber        Int?
  modality            String?
  plan                String              @default("FREE")
  planStatus          String              @default("ACTIVE")
  premiumUntil        DateTime?
  websiteUrl          String?
  featuredUntil       DateTime?
  isFeatured          Boolean             @default(false)
  payments            Payment[]
  athleteLinks        PlayerAthleteLink[]
  guardian            GuardianProfile     @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([guardianId])
}

model PlayerAthleteLink {
  id        String        @id @default(cuid())
  playerId  String
  athleteId String
  verified  Boolean       @default(false)
  createdAt DateTime      @default(now())
  athlete   Athlete       @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  player    PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, athleteId])
}

model Qtr {
  id             String       @id @default(cuid())
  title          String
  weekStart      DateTime
  dataJson       String
  published      Boolean      @default(false)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, weekStart])
  @@index([organizationId, weekStart])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model CoachProfile {
  id                      String                    @id @default(cuid())
  ownerUserId             String                    @unique
  slug                    String                    @unique
  name                    String
  professionalName        String?
  photoUrl                String?
  coverUrl                String?
  roleTitle               String?
  currentClub             String?
  categories              String?
  city                    String?
  state                   String?
  country                 String?
  nationality             String?
  bio                     String?
  experience              String?
  clubsHistory            String?
  licenses                String?
  education               String?
  languages               String?
  achievements            String?
  methodology             String?
  youtubeUrl              String?
  instagramUrl            String?
  linkedinUrl             String?
  contactEmail            String?
  directoryVisible        Boolean                   @default(true)
  isPublic                Boolean                   @default(false)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  featuredUntil           DateTime?
  isFeatured              Boolean                   @default(false)
  managedOrganizationType OrganizationType?
  managesOrganization     Boolean                   @default(false)
  organizationAccesses    CoachOrganizationAccess[]
  owner                   User                      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  referrals               GuardianProfile[]         @relation("CoachReferrals")

  @@index([directoryVisible, isPublic])
  @@index([roleTitle])
  @@index([currentClub])
}

model AthleteMembership {
  id              String       @id @default(cuid())
  athleteId       String
  organizationId  String
  categoryId      String?
  sport           SportType    @default(BOTH)
  teamLabel       String?
  competitionType String?
  season          String?
  status          String       @default("ACTIVE")
  verified        Boolean      @default(false)
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  athlete         Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  category        Category?    @relation(fields: [categoryId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([athleteId])
  @@index([organizationId, categoryId])
  @@index([status])
}

model CoachOrganizationAccess {
  id                            String       @id @default(cuid())
  coachId                       String
  organizationId                String
  categoryId                    String?
  sport                         SportType    @default(BOTH)
  roleTitle                     String?
  active                        Boolean      @default(true)
  canViewRoster                 Boolean      @default(true)
  canViewSchedule               Boolean      @default(true)
  canViewCallUps                Boolean      @default(true)
  canManageCallUps              Boolean      @default(false)
  canViewPerformance            Boolean      @default(false)
  canManagePerformance          Boolean      @default(false)
  canGeneratePerformanceReports Boolean      @default(false)
  createdAt                     DateTime     @default(now())
  updatedAt                     DateTime     @updatedAt
  requestedBy                   String       @default("CLUB")
  category                      Category?    @relation(fields: [categoryId], references: [id])
  coach                         CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  organization                  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([coachId, organizationId, categoryId, sport])
  @@index([coachId, active])
  @@index([organizationId, categoryId])
}

model Payment {
  id                String         @id @default(cuid())
  userId            String
  playerId          String?
  product           PaymentProduct
  status            PaymentStatus  @default(PENDING)
  method            String         @default("PIX")
  amountCents       Int
  pixTxid           String         @unique
  pixPayload        String?
  pixKeySnapshot    String?
  note              String?
  confirmedAt       DateTime?
  confirmedByUserId String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organizationId    String?
  organization      Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  player            PlayerProfile? @relation(fields: [playerId], references: [id])
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
  @@index([organizationId])
  @@index([playerId])
}

