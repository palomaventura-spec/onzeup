  canManageCallUps              Boolean      @default(false)
  canViewPerformance            Boolean      @default(false)
  canManagePerformance          Boolean      @default(false)
  canGeneratePerformanceReports Boolean      @default(false)
  createdAt                     DateTime     @default(now())
  updatedAt                     DateTime     @updatedAt
  requestedBy                   String       @default("CLUB")
  category                      Category?    @relation(fields: [categoryId], references: [id])
  coach                         CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  organization                  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([coachId, organizationId, categoryId, sport])
  @@index([coachId, active])
  @@index([organizationId, categoryId])
}

model Payment {
  id                String         @id @default(cuid())
  userId            String
  playerId          String?
  product           PaymentProduct
  status            PaymentStatus  @default(PENDING)
  method            String         @default("PIX")
  amountCents       Int
  pixTxid           String         @unique
  pixPayload        String?
  pixKeySnapshot    String?
  note              String?
  confirmedAt       DateTime?
  confirmedByUserId String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organizationId    String?
  organization      Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  player            PlayerProfile? @relation(fields: [playerId], references: [id])
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
  @@index([organizationId])
  @@index([playerId])
}

