model AthleteHistoryEntry {
  id                       String  @id @default(cuid())
  organizationId           String
  athleteId                String
  authorUserId             String?
  followUpResolvedByUserId String?

  source              AthleteHistorySource @default(MANUAL)
  sourceId            String?
  sourceLabelSnapshot String?

  topic      AthleteHistoryTopic      @default(GENERAL)
  visibility AthleteHistoryVisibility @default(TECHNICAL_STAFF)

  occurredAt DateTime @default(now())

  title   String?
  content String

  followUpRequired   Boolean   @default(false)
  followUpResolvedAt DateTime?

  categoryIdSnapshot        String?
  categoryNameSnapshot      String?
  categoryBirthYearSnapshot Int?
  sportSnapshot             SportType?
  seasonSnapshot            String?
  positionSnapshot          String?

  authorNameSnapshot     String?
  resolvedByNameSnapshot String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athlete      Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  author User? @relation("AthleteHistoryEntryAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  followUpResolvedBy User? @relation("AthleteHistoryEntryResolver", fields: [followUpResolvedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, athleteId, occurredAt])
  @@index([athleteId, source, occurredAt])
  @@index([organizationId, source, sourceId])
  @@index([organizationId, followUpRequired, followUpResolvedAt])
  @@index([authorUserId])
  @@index([followUpResolvedByUserId])
}

enum AthleteHistorySource {
  TRAINING
  MATCH
  EVALUATION
  GPS
  CATEGORY_CHANGE
  REPORT
  MANUAL
}

enum AthleteHistoryTopic {
  TECHNICAL
  TACTICAL
  PHYSICAL
  COGNITIVE
  EMOTIONAL
  BEHAVIORAL
  OCCURRENCE
  GENERAL
}

enum AthleteHistoryVisibility {
  TECHNICAL_STAFF
  MANAGEMENT
  SHAREABLE
}

model AdminSupportSession {
  id             String    @id @default(cuid())
  adminUserId    String
  organizationId String
  mode           String    @default("SUPPORT")
  reason         String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  adminUser    User         @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([adminUserId, startedAt])
  @@index([organizationId, startedAt])
  @@index([endedAt])
}

enum AthleteDocumentManualIssueStatus {
  OPEN
  RESOLVED
}

model AthleteDocumentManualIssue {
  id             String @id @default(cuid())
  organizationId String
  athleteId      String

  title    String
  notes    String?
  blocking Boolean                          @default(false)
  status   AthleteDocumentManualIssueStatus @default(OPEN)

  createdByUserId       String?
  createdByNameSnapshot String?
  createdAt             DateTime @default(now())

  resolvedAt             DateTime?
  resolvedByUserId       String?
  resolvedByNameSnapshot String?
  resolutionNotes        String?

  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athlete      Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  createdBy  User? @relation("AthleteDocumentManualIssueCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("AthleteDocumentManualIssueResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, athleteId, status])
  @@index([athleteId, blocking, status])
  @@index([createdAt])
}
